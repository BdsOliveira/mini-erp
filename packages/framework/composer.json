{
    "name": "bdsoliveira/framework",
    "description": "Framework minimalista para projetos PHP.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "twig/twig": "^3.21",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.10"
    },
    "require-dev": {
        "pestphp/pest": "^4.6",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
