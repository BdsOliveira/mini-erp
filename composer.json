{
    "name": "bdsoliveira/setup-projeto-mvc",
    "description": "Setup de projeto MVC em PHP dockerizado com serviços essenciais.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/framework"
        }
    ],
    "authors": [
        {
            "name": "BdsOliveira",
            "email": "bds.commus@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "bdsoliveira/framework": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^4.6",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
